# Neon Postgres — written automatically by `neon link` / `neon deploy` / `neon env pull`
# Pooled connection (hostname with -pooler), used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by Prisma Migrate / db push
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
CLOUDINARY_CLOUD_NAME="dyz8kdt5c"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
ADMIN_PASSWORD=""
JWT_SECRET=""
